export default class SaveLoadPopup {
  constructor(core) {
    this.core = core;
    this.visible = false;
    this.mode = "save"; // "save" or "load"
    this.hoverButton = { slot: -1, type: null };
    this.closeHover = false;

    // Pagination Hover State
    this.pageHover = { prev: false, next: false };

    // Base Resolution Reference
    this.baseWidth = 1920;
    this.baseHeight = 1080;

    // ----------------------------------------------------
    // 🔥 REUSABLE MODAL STATE
    // ----------------------------------------------------
    this.modal = {
      visible: false,
      message: "",
      subMessage: "",
      onConfirm: null,
      hoverYes: false,
      hoverNo: false,
    };

    this.totalSlots = 30;

    // Fixed 10 slots per page (2 rows x 5 cols)
    const SLOTS_ROWS = 2;
    const SLOTS_COLS = 5;

    this.slotsPerPage = SLOTS_ROWS * SLOTS_COLS; // 10
    this.totalPages = Math.ceil(this.totalSlots / this.slotsPerPage);
    this.currentPage = 1;

    // Placeholder initialization
    this.slots = Array(this.slotsPerPage)
      .fill(null)
      .map((_, i) => ({
        id: i,
        screenshot: null,
        header: "Slot " + i,
        date: "",
        chapter: "",
        data: null,
      }));

    this._moveHandler = (e) => this.onMouseMove(e);
    this._clickHandler = (e) => this.onClick(e);

    this.core.canvas.addEventListener("mousemove", this._moveHandler);
    this.core.canvas.addEventListener("click", this._clickHandler);

    this.loadAllSlots();
  }

  /* ----------------------------------------------------------
     ---------- HELPERS (Styling) ----------
     ---------------------------------------------------------- */

  hexToRgba(color, alpha = 1) {
    if (!color) return `rgba(0,0,0,${alpha})`;
    if (color.startsWith("rgba")) return color;
    if (color.startsWith("rgb")) return color;

    if (color[0] === "#") {
      let r, g, b;
      if (color.length === 4) {
        r = parseInt(color[1] + color[1], 16);
        g = parseInt(color[2] + color[2], 16);
        b = parseInt(color[3] + color[3], 16);
      } else {
        r = parseInt(color.slice(1, 3), 16);
        g = parseInt(color.slice(3, 5), 16);
        b = parseInt(color.slice(5, 7), 16);
      }
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }
    return color;
  }

  resolveRadius(rawRadius, scale) {
    if (Array.isArray(rawRadius) && rawRadius.length === 4) {
      return rawRadius.map((r) => r * scale);
    }
    const scaled =
      typeof rawRadius === "number" && rawRadius >= 0 ? rawRadius * scale : 0;
    return [scaled, scaled, scaled, scaled];
  }

  drawStyledBox(ctx, x, y, w, h, thickness, radii, bgColor, borderColor) {
    const resolved = Array.isArray(radii)
      ? radii
      : [radii, radii, radii, radii];
    const [tl, tr, br, bl] = resolved;
    const hasRadius = tl > 0 || tr > 0 || br > 0 || bl > 0;

    // Draw Background/Fill
    ctx.fillStyle = bgColor;
    ctx.beginPath();
    if (hasRadius) {
      if (ctx.roundRect) ctx.roundRect(x, y, w, h, resolved);
      else ctx.rect(x, y, w, h);
    } else {
      ctx.rect(x, y, w, h);
    }
    ctx.fill();

    // Draw Border
    if (thickness > 0) {
      ctx.lineWidth = thickness;
      ctx.strokeStyle = borderColor;
      const overlap = 1;
      const offset = thickness / 2 - overlap;
      const bx = x - offset;
      const by = y - offset;
      const bw = w + thickness - overlap * 2;
      const bh = h + thickness - overlap * 2;
      const outerRadii = resolved.map((r) => (r > 0 ? r + offset : 0));

      ctx.beginPath();
      if (hasRadius) {
        if (ctx.roundRect) ctx.roundRect(bx, by, bw, bh, outerRadii);
        else ctx.rect(bx, by, bw, bh);
      } else {
        ctx.rect(bx, by, bw, bh);
      }
      ctx.stroke();
    }
  }

  /* ----------------------------------------------------------
     ---------- LAYOUT CALCULATION ----------
     ---------------------------------------------------------- */

  // 🔥 Centralized layout logic to ensure hit-detection matches rendering
  getLayout() {
    const canvas = this.core.canvas;
    const guiData = this.core.dataCache?.gameGUI?.gui_saveLoad || {};
    const scaleX = canvas.width / this.baseWidth;
    const scaleY = canvas.height / this.baseHeight;

    // 1. Main Container
    const baseW = guiData.gui_saveLoad_Width || 1400;
    const baseH = guiData.gui_saveLoad_Height || 800;

    const winW = baseW * scaleX;
    const winH = baseH * scaleY;
    const winX = (canvas.width - winW) / 2;
    const winY = (canvas.height - winH) / 2;

    const padding = (guiData.gui_saveLoad_Padding || 40) * scaleX;

    // 2. Title Area
    const titleFontSize = (guiData.gui_saveLoad_TitleFontSize || 40) * scaleX;
    const titleY = winY + padding;

    // 3. Close Button (Top Right of Window)
    const closeSize = 40 * scaleX;
    const closeX = winX + winW - padding - closeSize;
    const closeY = winY + padding / 2;

    // 4. Grid Slots
    const slotBaseW = guiData.gui_saveLoad_SlotWidth || 280;
    const slotBaseH = guiData.gui_saveLoad_SlotHeight || 200;
    const slotBaseSpacing = guiData.gui_saveLoad_SlotSpacing || 20;

    const slotW = slotBaseW * scaleX;
    const slotH = slotBaseH * scaleY;
    const spacing = slotBaseSpacing * scaleX;

    const cols = 5;
    const rows = 2;

    const gridW = cols * slotW + (cols - 1) * spacing;
    const gridH = rows * slotH + (rows - 1) * spacing;

    // Center grid in the remaining space below title
    const contentStartY = titleY + titleFontSize + padding;
    const gridX = winX + (winW - gridW) / 2;
    const gridY =
      contentStartY + (winH - (contentStartY - winY) - gridH - padding) / 2;

    // 5. Pagination Buttons (Updated with GUI Data)
    const pageBtnBaseW = guiData.gui_saveLoad_PageButtonWidth || 120;
    const pageBtnBaseH = guiData.gui_saveLoad_PageButtonHeight || 45;
    const pageMargin = guiData.gui_saveLoad_PageButtonMargin || 30; // distance from center text

    const pageBtnW = pageBtnBaseW * scaleX;
    const pageBtnH = pageBtnBaseH * scaleY;

    // Position buttons relative to bottom of window
    const pageY = winY + winH - padding - pageBtnH;
    const centerX = winX + winW / 2;

    // Prev button to the left of center text
    const prevX = centerX - pageMargin * scaleX - pageBtnW;
    // Next button to the right of center text
    const nextX = centerX + pageMargin * scaleX;

    return {
      scaleX,
      scaleY,
      win: { x: winX, y: winY, w: winW, h: winH },
      close: { x: closeX, y: closeY, size: closeSize },
      grid: { x: gridX, y: gridY, slotW, slotH, spacing, cols, rows },
      page: { y: pageY, btnW: pageBtnW, btnH: pageBtnH, prevX, nextX, centerX },
      title: {
        x: winX + padding,
        y: titleY + titleFontSize / 2,
        size: titleFontSize,
      },
      guiData, // pass raw data for colors
    };
  }

  /* ----------------------------------------------------------
     ---------- LOGIC METHODS (Unchanged) ----------
     ---------------------------------------------------------- */

  open(mode = "save") {
    this.visible = false;
    this.modal.visible = false;
    this.mode = mode;
    this.loadAllSlots();

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        // Lower quality for performance
        this.prePopupScreenshot = this.core.canvas.toDataURL(
          "image/jpeg",
          0.07
        );
        this.visible = true;
      });
    });
  }

  close() {
    this.visible = false;
    this.modal.visible = false;
  }

  dispose() {
    this.core.canvas.removeEventListener("mousemove", this._moveHandler);
    this.core.canvas.removeEventListener("click", this._clickHandler);
  }

  getLatestSlotIndex() {
    let latestIndex = -1;
    let latestTime = 0;

    for (let i = 0; i < this.totalSlots; i++) {
      const saved = localStorage.getItem("vn_save_slot_" + i);
      if (saved) {
        try {
          const data = JSON.parse(saved);
          if (data.timestamp) {
            const time = new Date(data.timestamp).getTime();
            if (!isNaN(time) && time > latestTime) {
              latestTime = time;
              latestIndex = i;
            }
          }
        } catch (e) {
          console.warn("Error parsing slot", i);
        }
      }
    }
    return latestIndex;
  }

  loadAllSlots() {
    if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
    if (this.currentPage < 1) this.currentPage = 1;

    const latestSlotIndex = this.getLatestSlotIndex();
    const start = (this.currentPage - 1) * this.slotsPerPage;
    const end = Math.min(start + this.slotsPerPage, this.totalSlots);
    const slotsToRender = end - start;

    this.slots = Array(slotsToRender)
      .fill(null)
      .map((_, i) => {
        const slotIndex = start + i;
        let headerText = slotIndex === 0 ? "Autosave" : "Slot " + slotIndex;
        if (slotIndex === latestSlotIndex) {
          headerText += " - Latest";
        }

        const slot = {
          id: slotIndex,
          screenshot: null,
          header: headerText,
          date: "",
          chapter: "",
          data: null,
        };

        const saved = localStorage.getItem("vn_save_slot_" + slotIndex);
        if (saved) {
          const data = JSON.parse(saved);
          slot.date = data.timestamp || "";
          slot.chapter = data.chapter || "Chapter 1 - Episode 1";
          slot.data = data;
          if (data.screenshot) {
            const img = new Image();
            img.src = data.screenshot;
            slot.screenshot = img;
          }
        }
        return slot;
      });
  }

  _executeSave(index) {
    const slotKey = "vn_save_slot_" + index;
    const screenshotBase64 = this.prePopupScreenshot;
    const timestamp = new Date().toLocaleString();
    const chapter = "Chapter 1 - Episode 1";

    const saveData = {
      timestamp,
      chapter,
      screenshot: screenshotBase64,
      gameState: structuredClone(this.core.gameState),
      characters: structuredClone(this.core.characters),
    };

    localStorage.setItem(slotKey, JSON.stringify(saveData));
    this.loadAllSlots();
    console.log(`Saved slot ${index}`);
  }

  _executeDelete(index) {
    const slotKey = "vn_save_slot_" + index;
    localStorage.removeItem(slotKey);
    this.loadAllSlots();
    console.log(`Deleted slot ${index}`);
  }

  async loadSlot(index) {
    const currentSlot = this.slots.find((s) => s.id === index);
    const slot = currentSlot ? currentSlot.data : null;
    if (!slot) return;

    this.core.gameState = structuredClone(slot.gameState);
    this.core.characters = structuredClone(slot.characters);
    this.core.currentCharacter =
      this.core.characters.find((ch) => ch.default === true) ||
      this.core.characters[0];

    const gs = this.core.gameState;

    if (gs.currentBackground?.active) {
      const { Background } = await import("../background.js");
      const bg = new Background(this.core, gs.currentBackground.target);
      await bg.load();
      this.close();
      this.core.setActiveScene(bg);
      return;
    }

    if (gs.currentScene?.active) {
      const { Scene } = await import("../scene.js");
      const scene = new Scene(this.core, gs.currentScene.target);
      await scene.load();
      const savedIndex =
        typeof gs.currentScene.dialogues === "number"
          ? gs.currentScene.dialogues
          : 0;
      scene.currentLine = savedIndex;
      scene.resumeIndex = savedIndex;
      this.close();
      this.core.setActiveScene(scene);
      return;
    }
  }

  showModal(message, subMessage, onConfirm) {
    this.modal.message = message;
    this.modal.subMessage = subMessage;
    this.modal.onConfirm = onConfirm;
    this.modal.visible = true;
    this.modal.hoverYes = false;
    this.modal.hoverNo = false;
  }

  getLines(ctx, text, maxWidth) {
    const words = text.split(" ");
    const lines = [];
    let currentLine = words[0];
    for (let i = 1; i < words.length; i++) {
      const word = words[i];
      const width = ctx.measureText(currentLine + " " + word).width;
      if (width < maxWidth) {
        currentLine += " " + word;
      } else {
        lines.push(currentLine);
        currentLine = word;
      }
    }
    lines.push(currentLine);
    return lines;
  }

  getModalLayout(ctx, canvas) {
    const modalW = canvas.width * 0.4;
    const padding = modalW * 0.1;
    const fontSize = canvas.height * 0.03;
    ctx.font = `${fontSize}px Arial`;

    const maxTextWidth = modalW - padding * 2;
    const textLines = this.getLines(ctx, this.modal.message, maxTextWidth);
    const subMsgLines = this.modal.subMessage
      ? this.getLines(ctx, this.modal.subMessage, maxTextWidth)
      : [];

    const lineHeight = fontSize * 1.5;
    const textBlockH = (textLines.length + subMsgLines.length) * lineHeight;
    const btnH = canvas.height * 0.05;
    const btnGap = canvas.height * 0.04;

    const modalH = padding + textBlockH + btnGap + btnH + padding;
    const modalX = (canvas.width - modalW) / 2;
    const modalY = (canvas.height - modalH) / 2;

    const btnW = modalW * 0.3;
    const btnY = modalY + modalH - padding - btnH;
    const yesX = modalX + modalW * 0.15;
    const noX = modalX + modalW - btnW - modalW * 0.15;

    return {
      modalX,
      modalY,
      modalW,
      modalH,
      textLines,
      subMsgLines,
      lineHeight,
      btnX: { yes: yesX, no: noX },
      btnY,
      btnW,
      btnH,
      padding,
    };
  }

  /* ----------------------------------------------------------
     ---------- INPUT HANDLING ----------
     ---------------------------------------------------------- */

  onMouseMove(e) {
    if (!this.visible) return;
    const rect = this.core.canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    this.hoverButton = { slot: -1, type: null };
    this.closeHover = false;
    this.pageHover = { prev: false, next: false };

    // 1. Modal Logic
    if (this.modal.visible) {
      this.modal.hoverYes = false;
      this.modal.hoverNo = false;
      const ctx = this.core.canvas.getContext("2d");
      const layout = this.getModalLayout(ctx, this.core.canvas);

      if (
        x >= layout.btnX.yes &&
        x <= layout.btnX.yes + layout.btnW &&
        y >= layout.btnY &&
        y <= layout.btnY + layout.btnH
      ) {
        this.modal.hoverYes = true;
      } else if (
        x >= layout.btnX.no &&
        x <= layout.btnX.no + layout.btnW &&
        y >= layout.btnY &&
        y <= layout.btnY + layout.btnH
      ) {
        this.modal.hoverNo = true;
      }
      return;
    }

    const L = this.getLayout();

    // 2. Close Button
    if (
      x >= L.close.x &&
      x <= L.close.x + L.close.size &&
      y >= L.close.y &&
      y <= L.close.y + L.close.size
    ) {
      this.closeHover = true;
      return;
    }

    // 3. Pagination Buttons
    // Prev
    if (
      x >= L.page.prevX &&
      x <= L.page.prevX + L.page.btnW &&
      y >= L.page.y &&
      y <= L.page.y + L.page.btnH
    ) {
      this.pageHover.prev = true;
    }
    // Next
    if (
      x >= L.page.nextX &&
      x <= L.page.nextX + L.page.btnW &&
      y >= L.page.y &&
      y <= L.page.y + L.page.btnH
    ) {
      this.pageHover.next = true;
    }

    // 4. Slot Buttons
    this.slots.forEach((slot, i) => {
      const col = i % L.grid.cols;
      const row = Math.floor(i / L.grid.cols);
      const bx = L.grid.x + col * (L.grid.slotW + L.grid.spacing);
      const by = L.grid.y + row * (L.grid.slotH + L.grid.spacing);

      const btnH = L.grid.slotH * 0.15;
      const btnBottomPadding = 10 * L.scaleY;
      const btnY = by + L.grid.slotH - btnH - btnBottomPadding;

      const btnCount = 3;
      const btnSpacing = 5 * L.scaleX;
      const slotPadding = 10 * L.scaleX;
      const totalBtnWidth =
        L.grid.slotW - slotPadding * 2 - btnSpacing * (btnCount - 1);
      const btnW = totalBtnWidth / btnCount;

      ["Save", "Load", "Delete"].forEach((label, idx) => {
        const btnX = bx + slotPadding + idx * (btnW + btnSpacing);
        // Visibility Check
        if (label === "Save" && this.mode === "load") return;
        if (label === "Load" && this.mode === "save") return;
        if (label === "Delete" && !slot.data) return;
        if (label === "Load" && !slot.data) return;

        if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {
          this.hoverButton = { slot: i, type: label };
        }
      });
    });
  }

  onClick(e) {
    if (!this.visible) return;
    e.stopImmediatePropagation();
    e.preventDefault();

    const rect = this.core.canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (this.modal.visible) {
      if (this.modal.hoverYes && this.modal.onConfirm) {
        this.modal.onConfirm();
        this.modal.visible = false;
      } else if (this.modal.hoverNo) {
        this.modal.visible = false;
      }
      return;
    }

    if (this.closeHover) {
      this.close();
      return;
    }

    const L = this.getLayout();

    // Pagination Click
    // Prev
    if (
      x >= L.page.prevX &&
      x <= L.page.prevX + L.page.btnW &&
      y >= L.page.y &&
      y <= L.page.y + L.page.btnH
    ) {
      if (this.currentPage > 1) {
        this.currentPage--;
        this.loadAllSlots();
      }
      return;
    }
    // Next
    if (
      x >= L.page.nextX &&
      x <= L.page.nextX + L.page.btnW &&
      y >= L.page.y &&
      y <= L.page.y + L.page.btnH
    ) {
      if (this.currentPage < this.totalPages) {
        this.currentPage++;
        this.loadAllSlots();
      }
      return;
    }

    // Slot Actions
    const { slot, type } = this.hoverButton;
    if (slot !== -1 && type) {
      const realIndex = this.slots[slot].id;
      const s = this.slots[slot];

      if (type === "Save") {
        if (s.data) {
          this.showModal("Overwrite this slot?", `(Slot ${realIndex})`, () =>
            this._executeSave(realIndex)
          );
        } else {
          this._executeSave(realIndex);
        }
      } else if (type === "Load") {
        this.loadSlot(realIndex);
      } else if (type === "Delete") {
        this.showModal("Delete this save?", "This cannot be undone.", () =>
          this._executeDelete(realIndex)
        );
      }
    }
  }

  /* ----------------------------------------------------------
     ---------- RENDER ----------
     ---------------------------------------------------------- */

  drawButton(ctx, x, y, w, h, label, isHover, slot, scale) {
    const isDisabled = (label === "Delete" || label === "Load") && !slot.data;

    ctx.save();

    // Slot Button Colors
    const bgColor = isHover ? "#e0b383" : "#ffcc95";
    const borderColor = "#43321e";
    const fill = isDisabled ? "rgba(255, 204, 149, 0.3)" : bgColor;

    this.drawStyledBox(
      ctx,
      x,
      y,
      w,
      h,
      2,
      5 * scale,
      fill,
      isDisabled ? "transparent" : borderColor
    );

    ctx.fillStyle = isDisabled ? "rgba(67, 50, 30, 0.5)" : "#43321e";
    ctx.font = `bold ${h * 0.5}px Arial`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(label, x + w / 2, y + h / 2);

    ctx.restore();
  }

  drawModal(ctx, canvas) {
    const layout = this.getModalLayout(ctx, canvas);
    const {
      modalX,
      modalY,
      modalW,
      modalH,
      textLines,
      subMsgLines,
      lineHeight,
      btnX,
      btnY,
      btnW,
      btnH,
      padding,
    } = layout;

    ctx.fillStyle = "rgba(0,0,0,0.6)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    this.drawStyledBox(
      ctx,
      modalX,
      modalY,
      modalW,
      modalH,
      4,
      15,
      "#fef1e1",
      "#ffcc95"
    );

    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    ctx.fillStyle = "#43321e";
    const fontSize = canvas.height * 0.03;
    ctx.font = `bold ${fontSize}px Arial`;

    let textCursorY = modalY + padding;
    textLines.forEach((line) => {
      ctx.fillText(line, modalX + modalW / 2, textCursorY);
      textCursorY += lineHeight;
    });

    if (subMsgLines.length > 0) {
      ctx.font = `${fontSize * 0.8}px Arial`;
      ctx.fillStyle = "#666";
      subMsgLines.forEach((line) => {
        ctx.fillText(line, modalX + modalW / 2, textCursorY);
        textCursorY += lineHeight;
      });
    }

    const yesColor = this.modal.hoverYes ? "#35a440" : "#2e8c37";
    this.drawStyledBox(
      ctx,
      btnX.yes,
      btnY,
      btnW,
      btnH,
      2,
      5,
      yesColor,
      "#1f6025"
    );
    ctx.fillStyle = "#fff";
    ctx.textBaseline = "middle";
    ctx.font = `bold ${btnH * 0.5}px Arial`;
    ctx.fillText("YES", btnX.yes + btnW / 2, btnY + btnH / 2);

    const noColor = this.modal.hoverNo ? "#e05737" : "#c0482e";
    this.drawStyledBox(
      ctx,
      btnX.no,
      btnY,
      btnW,
      btnH,
      2,
      5,
      noColor,
      "#853120"
    );
    ctx.fillStyle = "#fff";
    ctx.fillText("NO", btnX.no + btnW / 2, btnY + btnH / 2);
  }

  render(ctx) {
    if (!this.visible) return;
    const canvas = this.core.canvas;
    const L = this.getLayout();
    const guiData = L.guiData;

    // 1. Dim Background
    ctx.fillStyle = "rgba(0,0,0,0.8)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // 2. Main Window
    const winBg = this.hexToRgba(
      guiData.gui_saveLoad_BackgroundColor || "#fef1e1",
      guiData.gui_saveLoad_Opacity || 0.98
    );
    const winBorder = guiData.gui_saveLoad_BorderColor || "#ffcc95";
    const winThick = (guiData.gui_saveLoad_BorderThickness || 10) * L.scaleX;
    const winRadii = this.resolveRadius(
      guiData.gui_saveLoad_BorderCorner || 20,
      L.scaleX
    );

    this.drawStyledBox(
      ctx,
      L.win.x,
      L.win.y,
      L.win.w,
      L.win.h,
      winThick,
      winRadii,
      winBg,
      winBorder
    );

    // 3. Title
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    ctx.font = `bold ${L.title.size}px ${
      guiData.gui_saveLoad_FontFamily || "Arial"
    }`;
    ctx.fillStyle = guiData.gui_saveLoad_TitleFontColor || "#43321e";
    const titleText = this.mode === "save" ? "Save Game" : "Load Game";
    ctx.fillText(titleText, L.title.x, L.title.y);

    // 4. Close Button
    const closeColor = guiData.gui_saveLoad_CloseButtonColor || "#c83232";
    const closeTxtColor = guiData.gui_saveLoad_CloseButtonTextColor || "#fff";
    this.drawStyledBox(
      ctx,
      L.close.x,
      L.close.y,
      L.close.size,
      L.close.size,
      2,
      5 * L.scaleX,
      this.closeHover ? "#ff5555" : closeColor,
      "#fff"
    );
    ctx.fillStyle = closeTxtColor;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font = `bold ${L.close.size * 0.6}px Arial`;
    ctx.fillText(
      "X",
      L.close.x + L.close.size / 2,
      L.close.y + L.close.size / 2 + 2
    );

    // 5. Grid Slots
    const slotBg = guiData.gui_saveLoad_SlotBackgroundColor || "#ffffff";
    const slotBorder = guiData.gui_saveLoad_SlotBorderColor || "#dcb43c";
    const slotThick =
      (guiData.gui_saveLoad_SlotBorderThickness || 3) * L.scaleX;
    const slotRadii = this.resolveRadius(
      guiData.gui_saveLoad_SlotBorderCorner || 10,
      L.scaleX
    );
    const slotFontColor = guiData.gui_saveLoad_SlotFontColor || "#43321e";
    const slotFontSize = (guiData.gui_saveLoad_SlotFontSize || 16) * L.scaleX;

    this.slots.forEach((slot, i) => {
      const col = i % L.grid.cols;
      const row = Math.floor(i / L.grid.cols);
      const bx = L.grid.x + col * (L.grid.slotW + L.grid.spacing);
      const by = L.grid.y + row * (L.grid.slotH + L.grid.spacing);

      this.drawStyledBox(
        ctx,
        bx,
        by,
        L.grid.slotW,
        L.grid.slotH,
        slotThick,
        slotRadii,
        slotBg,
        slotBorder
      );

      const headerH = L.grid.slotH * 0.12;
      ctx.fillStyle = slotFontColor;
      ctx.font = `bold ${slotFontSize}px Arial`;
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      ctx.fillText(slot.header, bx + L.grid.slotW / 2, by + 10 * L.scaleY);

      const thumbH = L.grid.slotH * 0.45;
      const thumbY = by + headerH + 8 * L.scaleY;
      const thumbMargin = 15 * L.scaleX;
      const thumbW = L.grid.slotW - thumbMargin * 2;

      if (slot.screenshot instanceof Image) {
        ctx.drawImage(
          slot.screenshot,
          bx + thumbMargin,
          thumbY,
          thumbW,
          thumbH
        );
        ctx.strokeStyle = "#ccc";
        ctx.lineWidth = 1;
        ctx.strokeRect(bx + thumbMargin, thumbY, thumbW, thumbH);
      } else {
        ctx.fillStyle = "#eee";
        ctx.fillRect(bx + thumbMargin, thumbY, thumbW, thumbH);
        ctx.fillStyle = "#aaa";
        ctx.font = `${slotFontSize}px Arial`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("Empty", bx + L.grid.slotW / 2, thumbY + thumbH / 2);
      }

      if (slot.data) {
        ctx.fillStyle = "#666";
        ctx.font = `${slotFontSize * 0.8}px Arial`;
        const infoY = thumbY + thumbH + 5 * L.scaleY;
        ctx.textBaseline = "top";
        ctx.fillText(slot.date, bx + L.grid.slotW / 2, infoY);
      }

      // Action Buttons
      const btnH = L.grid.slotH * 0.15;
      const btnBottomPadding = 10 * L.scaleY;
      const btnY = by + L.grid.slotH - btnH - btnBottomPadding;
      const btnCount = 3;
      const btnSpacing = 5 * L.scaleX;
      const slotPadding = 10 * L.scaleX;
      const totalBtnWidth =
        L.grid.slotW - slotPadding * 2 - btnSpacing * (btnCount - 1);
      const btnW = totalBtnWidth / btnCount;

      ["Save", "Load", "Delete"].forEach((label, idx) => {
        const btnX = bx + slotPadding + idx * (btnW + btnSpacing);
        const isHover =
          this.hoverButton.slot === i && this.hoverButton.type === label;
        if (label === "Save" && this.mode === "load") return;
        if (label === "Load" && this.mode === "save") return;
        if (label === "Delete" && !slot.data) return;
        if (label === "Load" && !slot.data) return;
        this.drawButton(
          ctx,
          btnX,
          btnY,
          btnW,
          btnH,
          label,
          isHover,
          slot,
          L.scaleX
        );
      });
    });

    // 6. Pagination
    const pageBg = guiData.gui_saveLoad_PageButtonBackgroundColor || "#ffcc95";
    const pageBgHover =
      guiData.gui_saveLoad_PageButtonBackgroundColor_Hover || "#e0b383";
    const pageBgDisabled =
      guiData.gui_saveLoad_PageButtonBackgroundColor_Disabled || "#ccc";
    const pageBorder = guiData.gui_saveLoad_PageButtonBorderColor || "#43321e";
    const pageThick =
      (guiData.gui_saveLoad_PageButtonBorderThickness || 2) * L.scaleX;
    const pageRadii = this.resolveRadius(
      guiData.gui_saveLoad_PageButtonBorderCorner || 10,
      L.scaleX
    );
    const pageFontColor = guiData.gui_saveLoad_PageFontColor || "#43321e";
    const pageFontSize = (guiData.gui_saveLoad_PageFontSize || 20) * L.scaleX;

    ctx.font = `bold ${pageFontSize}px Arial`;

    // PREV
    const prevBg =
      this.currentPage > 1
        ? this.pageHover.prev
          ? pageBgHover
          : pageBg
        : pageBgDisabled;
    this.drawStyledBox(
      ctx,
      L.page.prevX,
      L.page.y,
      L.page.btnW,
      L.page.btnH,
      pageThick,
      pageRadii,
      prevBg,
      pageBorder
    );
    ctx.fillStyle = this.currentPage > 1 ? pageFontColor : "#888";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(
      "Prev",
      L.page.prevX + L.page.btnW / 2,
      L.page.y + L.page.btnH / 2
    );

    // NEXT
    const nextBg =
      this.currentPage < this.totalPages
        ? this.pageHover.next
          ? pageBgHover
          : pageBg
        : pageBgDisabled;
    this.drawStyledBox(
      ctx,
      L.page.nextX,
      L.page.y,
      L.page.btnW,
      L.page.btnH,
      pageThick,
      pageRadii,
      nextBg,
      pageBorder
    );
    ctx.fillStyle = this.currentPage < this.totalPages ? pageFontColor : "#888";
    ctx.fillText(
      "Next",
      L.page.nextX + L.page.btnW / 2,
      L.page.y + L.page.btnH / 2
    );

    // Page Indicator
    ctx.fillStyle = pageFontColor;
    ctx.fillText(
      `Page ${this.currentPage} / ${this.totalPages}`,
      L.page.centerX,
      L.page.y + L.page.btnH / 2
    );

    // 7. Modal
    if (this.modal.visible) {
      this.drawModal(ctx, canvas);
    }
  }
}
