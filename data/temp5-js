// components/save_load_popup.js
export default class SaveLoadPopup {
  constructor(core) {
    this.core = core;
    this.visible = false;

    this.hoverIndex = -1;
    this.closeHover = false;

    // 10 save slots placeholder
    this.slots = Array(10)
      .fill(null)
      .map((_, i) => ({
        id: i,
        screenshot: null,
        date: "Empty Slot " + i,
      }));

    this._moveHandler = (e) => this.onMouseMove(e);
    this._clickHandler = (e) => this.onClick(e);

    this.core.canvas.addEventListener("mousemove", this._moveHandler);
    this.core.canvas.addEventListener("click", this._clickHandler);
  }

  open() {
    this.visible = true;
  }
  close() {
    this.visible = false;
  }

  dispose() {
    this.core.canvas.removeEventListener("mousemove", this._moveHandler);
    this.core.canvas.removeEventListener("click", this._clickHandler);
  }

  // -----------------------------
  // MOUSE MOVE
  // -----------------------------
  onMouseMove(e) {
    if (!this.visible) return;

    const rect = this.core.canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const canvas = this.core.canvas;

    this.hoverIndex = -1;
    this.closeHover = false;

    // CLOSE BUTTON
    const closeSize = canvas.width * 0.03;
    const closeX = canvas.width * 0.88;
    const closeY = canvas.height * 0.05;
    if (
      x >= closeX &&
      x <= closeX + closeSize &&
      y >= closeY &&
      y <= closeY + closeSize
    ) {
      this.closeHover = true;
      return;
    }

    // CARD GRID
    const cols = 5;
    const rows = 2;
    const cardW = canvas.width * 0.16;
    const cardH = canvas.height * 0.28;
    const gapX = canvas.width * 0.025;
    const gapY = canvas.height * 0.04;
    const startX = canvas.width * 0.05;
    const startY = canvas.height * 0.17;

    this.slots.forEach((slot, i) => {
      const col = i % cols;
      const row = Math.floor(i / cols);

      const bx = startX + col * (cardW + gapX);
      const by = startY + row * (cardH + gapY);

      if (x >= bx && x <= bx + cardW && y >= by && y <= by + cardH) {
        this.hoverIndex = i;
      }
    });
  }

  // -----------------------------
  // CLICK
  // -----------------------------
  onClick(e) {
    if (!this.visible) return;
    if (this.closeHover) {
      this.close();
      return;
    }

    if (this.hoverIndex !== -1) {
      console.log("Clicked slot:", this.hoverIndex);
      // TODO: Add Save / Load / Delete popup actions
    }
  }

  // -----------------------------
  // RENDER
  // -----------------------------
  render(ctx) {
    if (!this.visible) return;

    const canvas = this.core.canvas;

    // BG dim
    ctx.fillStyle = "rgba(0,0,0,0.9)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // TITLE (top-left)
    ctx.fillStyle = "#fff";
    ctx.font = `${canvas.height * 0.045}px Arial`;
    ctx.textAlign = "left";
    ctx.fillText("Save / Load", canvas.width * 0.05, canvas.height * 0.07);

    // CLOSE BUTTON (top-right)
    const closeSize = canvas.width * 0.03;
    const closeX = canvas.width * 0.88;
    const closeY = canvas.height * 0.05;
    ctx.fillStyle = this.closeHover ? "red" : "white";
    ctx.fillRect(closeX, closeY, closeSize, closeSize);
    ctx.fillStyle = "black";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font = `${closeSize * 0.7}px Arial`;
    ctx.fillText("X", closeX + closeSize / 2, closeY + closeSize / 2);

    // CARD GRID
    const cols = 5;
    const rows = 2;
    const cardW = canvas.width * 0.16;
    const cardH = canvas.height * 0.28;
    const gapX = canvas.width * 0.025;
    const gapY = canvas.height * 0.04;
    const startX = canvas.width * 0.05;
    const startY = canvas.height * 0.17;

    this.slots.forEach((slot, i) => {
      const col = i % cols;
      const row = Math.floor(i / cols);

      const bx = startX + col * (cardW + gapX);
      const by = startY + row * (cardH + gapY);

      // CARD BG
      ctx.fillStyle =
        this.hoverIndex === i
          ? "rgba(255,255,255,0.15)"
          : "rgba(255,255,255,0.08)";
      ctx.fillRect(bx, by, cardW, cardH);

      // THUMBNAIL BOX (top of card)
      const thumbH = cardH * 0.55;
      ctx.fillStyle = "rgba(255,255,255,0.2)";
      ctx.fillRect(bx + 10, by + 10, cardW - 20, thumbH - 10);

      // BUTTONS (anchored at bottom of card)
      const btnH = cardH * 0.12;
      const btnBottomPadding = cardH * 0.035; // proportional to card height
      const btnY = by + cardH - btnH - btnBottomPadding;

      // DATE TEXT ("Empty Slot") -> centered strictly between thumbnail bottom and button top
      const spaceTop = by + 10 + thumbH; // bottom of thumbnail
      const spaceBottom = btnY; // top of buttons
      let dateY = spaceTop + (spaceBottom - spaceTop) / 2;

      // CLAMP dateY between thumbnail bottom and button top
      dateY = Math.max(spaceTop + 2, Math.min(dateY, spaceBottom - 2));

      ctx.fillStyle = "#fff";
      ctx.font = `${btnH * 0.8}px Arial`; // scaled font
      ctx.textAlign = "center";
      ctx.textBaseline = "middle"; // vertical center
      ctx.fillText(slot.date, bx + cardW / 2, dateY);

      // BUTTONS (proportional spacing)
      const btnCount = 3;
      const btnSpacing = (cardW - 20) * 0.03; // proportional spacing
      const totalBtnWidth = cardW - 20 - btnSpacing * (btnCount - 1);
      const btnW = totalBtnWidth / btnCount;

      ["Save", "Load", "Delete"].forEach((label, idx) => {
        const btnX = bx + 10 + idx * (btnW + btnSpacing);
        ctx.fillStyle = "rgba(255,255,255,0.2)";
        ctx.fillRect(btnX, btnY, btnW, btnH);

        ctx.fillStyle = "#fff";
        ctx.font = `${btnH * 0.6}px Arial`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(label, btnX + btnW / 2, btnY + btnH / 2);
      });
    });
  }
}
