export class DialogueBox {
  constructor(core) {
    this.core = core;

    this.speakerMinRatio = 0.08;
    this.speakerMaxRatio = 0.15;
    this.textMinRatio = 0.06;
    this.textMaxRatio = 0.12;

    // Typewriter
    this.fullText = "";
    this.displayText = "";
    this.charIndex = 0;
    this.lastTime = 0;
    this.speed = 20;
    this.isTyping = false;
    this.typingFinishedTime = null;

    // Modes
    this.autoMode = false;
    this.fastForwardMode = false;

    // Buttons
    this.autoButton = { x: 0, y: 0, width: 0, height: 0 };
    this.ffButton = { x: 0, y: 0, width: 0, height: 0 };

    // Avatar Image Caching
    this.lastSpeaker = null;
    this.activeAvatarImage = null;
    this.activeAvatarData = null;
  }

  toggleAuto() {
    this.autoMode = !this.autoMode;
    if (this.autoMode) {
      this.fastForwardMode = false;
      if (!this.isTyping) this.typingFinishedTime = Date.now();
    }
  }

  toggleFastForward() {
    this.fastForwardMode = !this.fastForwardMode;
    if (this.fastForwardMode) {
      this.autoMode = false;
      if (this.isTyping) this.skipTypewriter();
    }
  }

  startTyping(newText) {
    this.fullText = newText;
    if (this.fastForwardMode) {
      this.displayText = newText;
      this.charIndex = newText.length;
      this.isTyping = false;
      this.typingFinishedTime = Date.now();
    } else {
      this.displayText = "";
      this.charIndex = 0;
      this.lastTime = 0;
      this.isTyping = true;
      this.typingFinishedTime = null;
    }
  }

  skipTypewriter() {
    if (this.isTyping) {
      this.displayText = this.fullText;
      this.charIndex = this.fullText.length;
      this.isTyping = false;
      this.typingFinishedTime = Date.now();
      return true;
    }
    return false;
  }

  updateTyping(delta) {
    if (!this.isTyping) return;
    if (this.fastForwardMode) {
      this.skipTypewriter();
      return;
    }
    this.lastTime += delta;
    if (this.lastTime >= this.speed) {
      this.lastTime = 0;
      if (this.charIndex < this.fullText.length) {
        this.charIndex++;
        this.displayText = this.fullText.substring(0, this.charIndex);
      }
      if (this.charIndex >= this.fullText.length) {
        this.isTyping = false;
        this.typingFinishedTime = Date.now();
      }
    }
  }

  resolveSpeakerName(speaker) {
    if (speaker === "[player]") {
      return this.core.currentCharacter?.name || "Player";
    }
    return speaker;
  }

  getSpeakerData(speaker) {
    if (speaker === "[player]") {
      return this.core.currentCharacter;
    }
    return this.core.characters.find((c) => c.name === speaker);
  }

  handleClick(x, y) {
    // Check Auto Button
    if (
      x >= this.autoButton.x &&
      x <= this.autoButton.x + this.autoButton.width &&
      y >= this.autoButton.y &&
      y <= this.autoButton.y + this.autoButton.height
    ) {
      this.toggleAuto();
      return true;
    }

    // Check Fast Forward Button
    if (
      x >= this.ffButton.x &&
      x <= this.ffButton.x + this.ffButton.width &&
      y >= this.ffButton.y &&
      y <= this.ffButton.y + this.ffButton.height
    ) {
      this.toggleFastForward();
      return true;
    }

    return false;
  }

  // Helper function for RGBA color conversion
  hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  render(ctx, speaker, text) {
    // 1. Update Text Logic
    if (this.fullText !== text) {
      this.startTyping(text);
    }
    this.updateTyping(16.67);

    // 2. Setup Dimensions and GUI Data
    const canvas = this.core.canvas;
    const baseHeight = this.core.baseHeight;
    const baseWidth = this.core.baseWidth;
    const guiData = this.core.dataCache.gameGUI?.gui_dialoguebox;
    const globalSettings = this.core.dataCache.gameGUI?.game_gui_settings;

    if (!guiData || !globalSettings) {
      // Fallback to hardcoded values if data is missing
      ctx.fillStyle = "rgba(0,0,0,0.8)";
      const boxHeight = canvas.height * 0.25;
      ctx.fillRect(0, canvas.height - boxHeight, canvas.width, boxHeight);
      return;
    }

    // Calculate Scaled Height
    const dialogueBaseHeight = guiData.dialogueBox_Hieght || 300;
    const boxHeight = (dialogueBaseHeight / baseHeight) * canvas.height;

    const boxWidth = canvas.width; // Dialogue box background is still full width
    const boxY = canvas.height - boxHeight;

    // Get Styling
    const bgColor = guiData.dialogueBox_BackgroundColor || "#1A1A1A";
    const opacity = guiData.dialogueBox_Opacity || 0.9;
    const borderColor = guiData.dialogueBox_Border || "#fff";
    const borderThickness = guiData.dialogueBox_BorderThickness || 2;
    const fontFamily = globalSettings.fontFamily || "Arial";
    const dialogueBoxFillStyle = this.hexToRgba(bgColor, opacity);

    // Calculate Font & Speaker Box Dimensions FIRST (Needed for Avatar alignment)
    // We retain relative sizing (0.14, 0.1) but relative to the new calculated boxHeight
    const speakerFontSizeRatio = 0.14;
    const textFontSizeRatio = 0.1;

    const speakerFontSize = boxHeight * speakerFontSizeRatio;
    const textFontSize = boxHeight * textFontSizeRatio;

    const speakerPaddingY = speakerFontSize * 0.3;
    const speakerBoxHeight = speakerFontSize + speakerPaddingY * 2;

    // --- 3. Avatar Data Logic (No change) ---
    if (this.lastSpeaker !== speaker) {
      this.lastSpeaker = speaker;
      const charData = this.getSpeakerData(speaker);
      this.activeAvatarData = charData?.avatar_img || null;

      this.activeAvatarImage = null;

      if (this.activeAvatarData) {
        this.activeAvatarImage = new Image();
        const src = Array.isArray(this.activeAvatarData)
          ? this.activeAvatarData[0]
          : this.activeAvatarData;
        this.activeAvatarImage.src = src;
      }
    }

    // --- 4. Draw Main Dialogue Box Background ---
    ctx.fillStyle = dialogueBoxFillStyle;
    ctx.fillRect(0, boxY, boxWidth, boxHeight);

    // Draw Main Border (Only top border)
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = borderThickness;
    ctx.beginPath();
    ctx.moveTo(0, boxY);
    ctx.lineTo(boxWidth, boxY);
    ctx.stroke();

    // Global Left Margin
    const baseMarginX = canvas.width * 0.05;

    // --- 5. Render Avatar Image (POP-OUT LEFT) ---
    let contentOffsetX = 0;

    if (
      this.activeAvatarImage &&
      this.activeAvatarImage.complete &&
      this.activeAvatarData
    ) {
      const avatarTopY = boxY - speakerBoxHeight;
      const avatarHeight = boxHeight + speakerBoxHeight;
      const avatarWidth = avatarHeight;
      const avatarX = baseMarginX;

      // Draw Avatar
      if (Array.isArray(this.activeAvatarData)) {
        const [_, sx, sy, sw, sh] = this.activeAvatarData;
        ctx.drawImage(
          this.activeAvatarImage,
          sx,
          sy,
          sw,
          sh,
          avatarX,
          avatarTopY,
          avatarWidth,
          avatarHeight
        );
      } else {
        ctx.drawImage(
          this.activeAvatarImage,
          avatarX,
          avatarTopY,
          avatarWidth,
          avatarHeight
        );
      }

      // Set Offset for Text & Name Box
      const gap = canvas.width * 0.02;
      contentOffsetX = avatarWidth + gap;
    }

    // --- 6. Speaker Name Box (Uses custom styles) ---
    const resolvedSpeaker = this.resolveSpeakerName(speaker);

    if (resolvedSpeaker) {
      ctx.font = `bold ${speakerFontSize}px ${fontFamily}`;
      const speakerMetrics = ctx.measureText(resolvedSpeaker);

      const speakerPaddingX = speakerFontSize * 0.8;

      const speakerBoxWidth = speakerMetrics.width + speakerPaddingX * 2;
      // Height is already calculated above as `speakerBoxHeight`

      // Align box relative to content offset
      const speakerBoxX = baseMarginX + contentOffsetX;
      const speakerBoxY = boxY - speakerBoxHeight;

      // Use dialogue box background color for name box fill
      ctx.fillStyle = dialogueBoxFillStyle;
      ctx.fillRect(speakerBoxX, speakerBoxY, speakerBoxWidth, speakerBoxHeight);

      // Use dialogue box border style for name box border
      ctx.strokeStyle = borderColor;
      ctx.lineWidth = borderThickness;
      ctx.strokeRect(
        speakerBoxX,
        speakerBoxY,
        speakerBoxWidth,
        speakerBoxHeight
      );

      ctx.fillStyle = "#fff"; // Speaker name text color is still white
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(
        resolvedSpeaker,
        speakerBoxX + speakerBoxWidth / 2,
        speakerBoxY + speakerBoxHeight / 2
      );
    }

    // --- 7. Dialogue Text (Uses custom font family) ---
    ctx.fillStyle = "#fff"; // Dialogue text color is still white
    ctx.font = `${textFontSize}px ${fontFamily}`;
    ctx.textAlign = "left";
    ctx.textBaseline = "top";

    const textX = baseMarginX + contentOffsetX;
    const textY = boxY + boxHeight * 0.15;

    // Remaining width calculation
    const maxWidth = boxWidth - baseMarginX - contentOffsetX - baseMarginX;

    const lines = this.wrapText(ctx, this.displayText, maxWidth);
    const lineHeight = textFontSize * 1.4;

    for (let i = 0; i < lines.length; i++) {
      ctx.fillText(lines[i], textX, textY + i * lineHeight);
    }

    // --- 8. Buttons ---
    this.renderButtons(
      ctx,
      canvas,
      boxY,
      boxHeight,
      textFontSize,
      fontFamily,
      dialogueBoxFillStyle,
      borderColor,
      borderThickness
    );
  }

  renderButtons(
    ctx,
    canvas,
    boxY,
    boxHeight,
    baseFontSize,
    fontFamily,
    dialogueBoxFillStyle,
    borderColor,
    borderThickness
  ) {
    const autoFontSize = baseFontSize * 0.8;
    ctx.font = `${autoFontSize}px ${fontFamily}`;
    const btnPaddingX = autoFontSize * 0.8;
    const btnPaddingY = autoFontSize * 0.4;
    const gap = 10;

    // Skip Button
    const ffLabel = "Skip";
    const ffMetrics = ctx.measureText(ffLabel);
    const ffWidth = ffMetrics.width + btnPaddingX * 2;
    const btnHeight = autoFontSize + btnPaddingY * 2;

    const ffX = canvas.width - ffWidth - canvas.width * 0.03;
    const btnY = boxY + boxHeight - btnHeight - canvas.height * 0.02;

    this.ffButton = { x: ffX, y: btnY, width: ffWidth, height: btnHeight };

    // Use dialogue box fill style for non-active buttons
    ctx.fillStyle = this.fastForwardMode ? "#FF4500" : dialogueBoxFillStyle;
    ctx.fillRect(ffX, btnY, ffWidth, btnHeight);

    // Use dialogue box border style
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = borderThickness;
    ctx.strokeRect(ffX, btnY, ffWidth, btnHeight);

    ctx.fillStyle = "#fff";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(ffLabel, ffX + ffWidth / 2, btnY + btnHeight / 2);

    // Auto Button
    const autoLabel = this.autoMode ? "Auto ON" : "Auto";
    const autoMetrics = ctx.measureText(autoLabel);
    const autoWidth = autoMetrics.width + btnPaddingX * 2;
    const autoX = ffX - autoWidth - gap;

    this.autoButton = {
      x: autoX,
      y: btnY,
      width: autoWidth,
      height: btnHeight,
    };

    // Use dialogue box fill style for non-active buttons
    ctx.fillStyle = this.autoMode ? "#00cc55" : dialogueBoxFillStyle;
    ctx.fillRect(autoX, btnY, autoWidth, btnHeight);
    ctx.strokeRect(autoX, btnY, autoWidth, btnHeight); // Uses previously set strokeStyle

    ctx.fillStyle = "#fff";
    ctx.fillText(autoLabel, autoX + autoWidth / 2, btnY + btnHeight / 2);
  }

  wrapText(ctx, text, maxWidth) {
    const words = text.split(" ");
    let line = "";
    const lines = [];

    for (let w of words) {
      const test = line + w + " ";
      if (ctx.measureText(test).width > maxWidth && line !== "") {
        lines.push(line.trim());
        line = w + " ";
      } else {
        line = test;
      }
    }
    if (line) lines.push(line.trim());
    return lines;
  }
}
