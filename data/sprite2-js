// =====================================================
// 1. INTERNAL CLASS: Handles logic for ONE character
// =====================================================
class SpriteEntity {
  constructor(core) {
    this.core = core;
    this.image = null;

    // Destination (Screen) - Can be Number or String now
    this.x = 0;
    this.y = 0;
    this.width = 0;
    this.height = 0;

    // Source (Crop)
    this.sx = 0;
    this.sy = 0;
    this.sWidth = 0;
    this.sHeight = 0;

    // Design Resolution (Basehan ng positioning)
    this.DESIGN_WIDTH = this.core.baseWidth; // Assuming 16:9 Aspect Ratio
    this.DESIGN_HEIGHT = this.core.baseHeight;
  }

  async load(data) {
    let spriteData = data;

    // 1. Data Lookup
    if (data.character && data.pose) {
      const cache = this.core.dataCache?.characterSprites;
      if (cache && cache[data.character] && cache[data.character][data.pose]) {
        const baseData = cache[data.character][data.pose];
        spriteData = { ...baseData, ...data };
      } else {
        console.warn(`⚠️ Sprite not found: ${data.character} -> ${data.pose}`);
      }
    }

    // 2. Assign Properties
    // Note: this.x/this.y can now accept Strings ("center", "left -50")
    this.x = spriteData.x !== undefined ? spriteData.x : 0;
    this.y = spriteData.y !== undefined ? spriteData.y : 0;
    this.width = spriteData.width !== undefined ? spriteData.width : 0;
    this.height = spriteData.height !== undefined ? spriteData.height : 0;

    this.sx = spriteData.sx !== undefined ? spriteData.sx : 0;
    this.sy = spriteData.sy !== undefined ? spriteData.sy : 0;
    this.sWidth = spriteData.sWidth !== undefined ? spriteData.sWidth : null;
    this.sHeight = spriteData.sHeight !== undefined ? spriteData.sHeight : null;

    // 3. Load Image
    if (spriteData.image) {
      const img = new Image();
      img.src = spriteData.image;
      await new Promise((resolve) => (img.onload = resolve));
      this.image = img;
    }
  }

  /**
   * 🔥 HELPER: Parses keywords ("center", "right -50") into numbers
   * @param {String|Number} input - The value from JSON
   * @param {Number} containerSize - The size of the screen (Design Width/Height)
   * @param {Number} objectSize - The size of the sprite
   */
  parseCoordinate(input, containerSize, objectSize) {
    // If it's already a number, return it as is
    if (typeof input === "number") return input;
    if (!input) return 0;

    // Split string "left -50" -> ["left", "-50"]
    const parts = input.toString().split(" ");
    const keyword = parts[0].toLowerCase();

    // Get offset if exists (e.g., the "-50" part)
    let offset = 0;
    if (parts.length > 1) {
      offset = parseFloat(parts[1]);
      if (isNaN(offset)) offset = 0;
    }

    let position = 0;

    switch (keyword) {
      // X-Axis Keywords
      case "left":
        position = 0;
        break;
      case "center":
      case "middle":
        position = containerSize / 2 - objectSize / 2;
        break;
      case "right":
        position = containerSize - objectSize;
        break;

      // Y-Axis Keywords
      case "top":
        position = 0;
        break;
      case "bottom":
        position = containerSize - objectSize;
        break;

      default:
        // Try to parse as simple string number "100"
        position = parseFloat(keyword);
        if (isNaN(position)) position = 0;
    }

    return position + offset;
  }

  render(ctx) {
    if (!this.image) return;

    const canvas = this.core.canvas;
    const scaleFactor = canvas.height / this.DESIGN_HEIGHT;

    // A. Source Rect (Original Image)
    const finalSx = this.sx;
    const finalSy = this.sy;
    const finalSWidth =
      this.sWidth !== null ? this.sWidth : this.image.naturalWidth;
    const finalSHeight =
      this.sHeight !== null ? this.sHeight : this.image.naturalHeight;

    // B. Calculate Target Size (Design Units)
    // Ito yung size niya sa 1280x720 world bago i-scale sa screen
    const designW = this.width !== 0 ? this.width : finalSWidth;
    const designH = this.height !== 0 ? this.height : finalSHeight;

    // C. Calculate Position (Design Units) using Helper
    // Convert "center" -> 640 (minus half sprite width)
    const designX = this.parseCoordinate(this.x, this.DESIGN_WIDTH, designW);
    const designY = this.parseCoordinate(this.y, this.DESIGN_HEIGHT, designH);

    // D. Final Scale for Screen
    const drawX = designX * scaleFactor;
    const drawY = designY * scaleFactor;
    const drawW = designW * scaleFactor;
    const drawH = designH * scaleFactor;

    // E. Draw
    ctx.drawImage(
      this.image,
      finalSx,
      finalSy,
      finalSWidth,
      finalSHeight,
      drawX,
      drawY,
      drawW,
      drawH
    );
  }
}

// =====================================================
// 2. MAIN CLASS: Manages Multiple Sprites
// =====================================================
export class Sprite {
  constructor(core) {
    this.core = core;
    this.entities = [];
    this.visible = false;
  }

  async update(data) {
    if (!data) {
      this.clear();
      return;
    }

    const dataList = Array.isArray(data) ? data : [data];
    const newEntities = [];

    const promises = dataList.map(async (item) => {
      const entity = new SpriteEntity(this.core);
      await entity.load(item);
      newEntities.push(entity);
    });

    await Promise.all(promises);

    this.entities = newEntities;
    this.visible = true;
  }

  clear() {
    this.entities = [];
    this.visible = false;
  }

  render(ctx) {
    if (!this.visible || this.entities.length === 0) return;

    this.entities.forEach((entity) => {
      entity.render(ctx);
    });
  }
}
