// =====================================================
// 1. INTERNAL CLASS: Handles logic for ONE character
// =====================================================
class SpriteEntity {
  constructor(core) {
    this.core = core;
    this.image = null;

    // Destination (Screen)
    this.x = 0;
    this.y = 0;
    this.width = 0;
    this.height = 0;

    // Source (Crop)
    this.sx = 0;
    this.sy = 0;
    this.sWidth = 0;
    this.sHeight = 0;

    // Transition State
    this.transitionType = "none"; // "fade", "slide-left", "slide-right"
    this.alpha = 1; // Opacity (0 to 1)
    this.offsetX = 0; // For sliding effect

    // Animation Speed
    this.fadeSpeed = 0.05;
    this.slideSpeed = 25;

    // Design Resolution
    this.DESIGN_WIDTH = this.core.baseWidth || 1920;
    this.DESIGN_HEIGHT = this.core.baseHeight || 1080;
  }

  async load(data) {
    let spriteData = data;

    // 1. Data Lookup
    // data.character is now either a literal ID (e.g., 'jayson') or the substituted ID (e.g., 'andrea')
    if (data.character && data.pose) {
      const cache = this.core.dataCache?.characterSprites;
      if (cache && cache[data.character] && cache[data.character][data.pose]) {
        const baseData = cache[data.character][data.pose];
        spriteData = { ...baseData, ...data };
      } else {
        console.warn(`⚠️ Sprite not found: ${data.character} -> ${data.pose}`);
      }
    }

    // 2. Assign Properties
    this.x = spriteData.x !== undefined ? spriteData.x : 0;
    this.y = spriteData.y !== undefined ? spriteData.y : 0;
    this.width = spriteData.width !== undefined ? spriteData.width : 0;
    this.height = spriteData.height !== undefined ? spriteData.height : 0;

    this.sx = spriteData.sx !== undefined ? spriteData.sx : 0;
    this.sy = spriteData.sy !== undefined ? spriteData.sy : 0;
    this.sWidth = spriteData.sWidth !== undefined ? spriteData.sWidth : null;
    this.sHeight = spriteData.sHeight !== undefined ? spriteData.sHeight : null;

    // 3. Setup Transition
    this.transitionType = spriteData.transition || "none";

    if (this.transitionType === "fade") {
      this.alpha = 0; // Start invisible
    } else if (this.transitionType === "slide-left") {
      this.alpha = 0;
      this.offsetX = 100; // Start 100px to the right
    } else if (this.transitionType === "slide-right") {
      this.alpha = 0;
      this.offsetX = -100; // Start 100px to the left
    } else {
      this.alpha = 1;
      this.offsetX = 0;
    }

    // 4. Load Image
    if (spriteData.image) {
      const img = new Image();
      img.src = spriteData.image;
      await new Promise((resolve) => (img.onload = resolve));
      this.image = img;
    }
  }

  /**
   * 🔥 HELPER: Parses keywords ("center", "right -50") into numbers
   */
  parseCoordinate(input, containerSize, objectSize) {
    if (typeof input === "number") return input;
    if (!input) return 0;

    const parts = input.toString().split(" ");
    const keyword = parts[0].toLowerCase();

    let offset = 0;
    if (parts.length > 1) {
      offset = parseFloat(parts[1]);
      if (isNaN(offset)) offset = 0;
    }

    let position = 0;

    switch (keyword) {
      case "left":
        position = 0;
        break;
      case "center":
      case "middle":
        position = containerSize / 2 - objectSize / 2;
        break;
      case "right":
        position = containerSize - objectSize;
        break;
      case "top":
        position = 0;
        break;
      case "bottom":
        position = containerSize - objectSize;
        break;
      default:
        position = parseFloat(keyword);
        if (isNaN(position)) position = 0;
    }

    return position + offset;
  }

  // 🔥 Update Animation State (Called every frame inside render)
  updateAnimation() {
    if (this.alpha < 1) {
      this.alpha += this.fadeSpeed;
      if (this.alpha > 1) this.alpha = 1;
    }

    if (this.offsetX !== 0) {
      if (this.offsetX > 0) {
        this.offsetX -= this.slideSpeed;
        if (this.offsetX < 0) this.offsetX = 0;
      } else {
        this.offsetX += this.slideSpeed;
        if (this.offsetX > 0) this.offsetX = 0;
      }
    }
  }

  render(ctx) {
    if (!this.image) return;

    // Update Animation Values
    this.updateAnimation();

    const canvas = this.core.canvas;
    const scaleFactor = canvas.height / this.DESIGN_HEIGHT;

    // Source Rect
    const finalSx = this.sx;
    const finalSy = this.sy;
    const finalSWidth =
      this.sWidth !== null ? this.sWidth : this.image.naturalWidth;
    const finalSHeight =
      this.sHeight !== null ? this.sHeight : this.image.naturalHeight;

    // Target Size
    const designW = this.width !== 0 ? this.width : finalSWidth;
    const designH = this.height !== 0 ? this.height : finalSHeight;

    // Target Position
    const designX = this.parseCoordinate(this.x, this.DESIGN_WIDTH, designW);
    const designY = this.parseCoordinate(this.y, this.DESIGN_HEIGHT, designH);

    // Final Draw Coordinates (Apply scale AND animation offset)
    // Note: OffsetX is design units, so we scale it too.
    const drawX = (designX + this.offsetX) * scaleFactor;
    const drawY = designY * scaleFactor;
    const drawW = designW * scaleFactor;
    const drawH = designH * scaleFactor;

    // Apply Opacity
    const prevAlpha = ctx.globalAlpha;
    ctx.globalAlpha = this.alpha;

    ctx.drawImage(
      this.image,
      finalSx,
      finalSy,
      finalSWidth,
      finalSHeight,
      drawX,
      drawY,
      drawW,
      drawH
    );

    // Restore Opacity
    ctx.globalAlpha = prevAlpha;
  }
}

// =====================================================
// 2. MAIN CLASS: Manages Multiple Sprites
// =====================================================
export class Sprite {
  constructor(core) {
    this.core = core;
    this.entities = [];
    this.visible = false;
  }

  async update(data) {
    if (!data) {
      this.clear();
      return;
    }

    const dataList = Array.isArray(data) ? data : [data];

    // 🔥 NEW LOGIC: Substitute [player] with the actual character ID from GameState
    const playerCharId = this.core.gameState?.currentCharacterId;

    const processedDataList = dataList.map((item) => {
      // Check for the [player] placeholder
      if (item.character === "[player]") {
        if (!playerCharId) {
          console.warn(
            "⚠️ [player] placeholder used, but currentCharacterId is missing in gameState."
          );
          return item; // Return item as is, loading will likely fail
        }
        // Return a new object with the character ID substituted
        return { ...item, character: playerCharId };
      }
      return item;
    });
    // -------------------------------------------------------------

    // Reuse existing entities if possible to keep animations smooth?
    // For now, simple replace logic (transitions will play on new entities).
    const newEntities = [];

    // Use the processed list for loading
    const promises = processedDataList.map(async (item) => {
      const entity = new SpriteEntity(this.core);
      await entity.load(item);
      newEntities.push(entity);
    });

    await Promise.all(promises);

    this.entities = newEntities;
    this.visible = true;
  }

  clear() {
    this.entities = [];
    this.visible = false;
  }

  render(ctx) {
    if (!this.visible || this.entities.length === 0) return;

    this.entities.forEach((entity) => {
      entity.render(ctx);
    });
  }
}
