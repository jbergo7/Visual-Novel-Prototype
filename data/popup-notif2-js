export class PopupNotif {
  constructor(core) {
    this.core = core;
    this.popups = [];
    this.scaleRatio = core.scaleRatio || 1;

    // Base resolution reference
    this.baseWidth = 1920;
    this.baseHeight = 1080;
  }

  show(message, color = null) {
    const popup = {
      message,
      color: this.resolveColor(color), // Fill color based on type (red/blue/etc)
      alpha: 1,
      yOffset: 0,
      id: Date.now() + Math.random(),
    };

    this.popups.push(popup);

    // Auto remove after 2 seconds
    setTimeout(() => {
      this.fadeOut(popup);
    }, 2000);
  }

  resolveColor(colorName) {
    // Colors for the "Fill" or Background of the notification
    switch (colorName) {
      case "red":
        return "#c83232";
      case "green":
        return "#32b45a";
      case "blue":
        return "#3c78c8";
      case "gold":
      case "yellow":
        return "#dcb43c";
      default:
        // Default to dark gray if no color specified
        return "#333333";
    }
  }

  fadeOut(popup) {
    const fadeInterval = setInterval(() => {
      popup.alpha -= 0.05;

      // Move slightly up while fading
      popup.yOffset -= 1 * this.scaleRatio;

      if (popup.alpha <= 0) {
        clearInterval(fadeInterval);
        this.popups = this.popups.filter((p) => p.id !== popup.id);
      }
    }, 50);
  }

  onResize(scaleRatio) {
    this.scaleRatio = scaleRatio;
  }

  /* -------------------------
       ---------- HELPERS ----------
       ------------------------- */

  hexToRgba(color, alpha = 1) {
    if (!color) return `rgba(0,0,0,${alpha})`;
    if (color.startsWith("rgba")) {
      // Replace existing alpha if needed, simpler to just return or parse
      // For now, assuming inputs are hex or simple rgb
      return color;
    }
    if (color.startsWith("rgb")) return color;

    if (color[0] === "#") {
      let r, g, b;
      if (color.length === 4) {
        r = parseInt(color[1] + color[1], 16);
        g = parseInt(color[2] + color[2], 16);
        b = parseInt(color[3] + color[3], 16);
      } else {
        r = parseInt(color.slice(1, 3), 16);
        g = parseInt(color.slice(3, 5), 16);
        b = parseInt(color.slice(5, 7), 16);
      }
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }
    return color;
  }

  resolveRadius(rawRadius, scale) {
    if (Array.isArray(rawRadius) && rawRadius.length === 4) {
      return rawRadius.map((r) => r * scale);
    }
    const scaled =
      typeof rawRadius === "number" && rawRadius >= 0 ? rawRadius * scale : 0;
    return [scaled, scaled, scaled, scaled];
  }

  // Reuse the robust Box Drawing logic from DialogueBox
  drawStyledBox(ctx, x, y, w, h, thickness, radii, bgColor, borderColor) {
    const resolved = Array.isArray(radii)
      ? radii
      : [radii, radii, radii, radii];
    const [tl, tr, br, bl] = resolved;
    const hasRadius = tl > 0 || tr > 0 || br > 0 || bl > 0;

    // Draw Background
    ctx.fillStyle = bgColor;
    ctx.beginPath();
    if (hasRadius) {
      if (ctx.roundRect) {
        ctx.roundRect(x, y, w, h, resolved);
      } else {
        ctx.moveTo(x + tl, y);
        ctx.lineTo(x + w - tr, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + tr);
        ctx.lineTo(x + w, y + h - br);
        ctx.quadraticCurveTo(x + w, y + h, x + w - br, y + h);
        ctx.lineTo(x + bl, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - bl);
        ctx.lineTo(x, y + tl);
        ctx.quadraticCurveTo(x, y, x + tl, y);
      }
    } else {
      ctx.rect(x, y, w, h);
    }
    ctx.fill();

    // Draw Border
    if (thickness > 0) {
      ctx.lineWidth = thickness;
      ctx.strokeStyle = borderColor;

      // Overlap logic to prevent gaps
      const overlap = 1;
      const offset = thickness / 2 - overlap;

      const bx = x - offset;
      const by = y - offset;
      const bw = w + thickness - overlap * 2;
      const bh = h + thickness - overlap * 2;

      const outerRadii = resolved.map((r) => (r > 0 ? r + offset : 0));
      const [o_tl, o_tr, o_br, o_bl] = outerRadii;
      const hasOuterRadius = o_tl > 0 || o_tr > 0 || o_br > 0 || o_bl > 0;

      ctx.beginPath();
      if (hasOuterRadius) {
        if (ctx.roundRect) ctx.roundRect(bx, by, bw, bh, outerRadii);
        else {
          // Manual fallback if needed, but roundRect is widely supported in modern browsers
          ctx.rect(bx, by, bw, bh);
        }
      } else {
        ctx.rect(bx, by, bw, bh);
      }
      ctx.stroke();
    }
  }

  /* -------------------------
       ---------- RENDER ----------
       ------------------------- */

  render(ctx) {
    if (this.popups.length === 0) return;

    const guiData = this.core.dataCache?.gameGUI?.gui_popupNotif;
    if (!guiData) return; // Wait for data

    const canvas = this.core.canvas;
    const scaleX = canvas.width / this.baseWidth;
    const scaleY = canvas.height / this.baseHeight;

    // --- Config Values ---
    const baseW = guiData.gui_popupNotif_Width || 420;
    const baseH = guiData.gui_popupNotif_Hieght || 60; // Typo support "Hieght"
    const basePadding = guiData.gui_popupNotif_Padding || 5;

    const popupWidth = baseW * scaleX;
    const popupHeight = baseH * scaleY;
    const spacing = 10 * scaleY; // Space between stack

    const opacity = guiData.gui_popupNotif_Opacity ?? 1;
    const fontColor = guiData.gui_popupNotif_FontColor || "#fff";

    // Border Settings
    const borderThickness =
      (guiData.gui_popupNotif_BorderThickness || 0) * scaleX;
    const borderColor = guiData.gui_popupNotif_BorderColor || "#fff";
    const cornerRadii = this.resolveRadius(
      guiData.gui_popupNotif_BorderCorner || 0,
      scaleX
    );

    // Font
    const globalSettings = this.core.dataCache?.gameGUI?.game_gui_settings;
    const fontFamily = globalSettings?.fontFamily || "Arial, sans-serif";
    const fontSize = (globalSettings?.fontSize || 25) * scaleX;

    // --- Positioning Logic ---
    const positionString = guiData.gui_popupNotif_Position || "top 50";
    const parts = positionString
      .split(" ")
      .map((s) => s.trim())
      .filter(Boolean);
    const posKeyword = (parts[0] || "top").toLowerCase();
    const posMargin = (parseFloat(parts[1]) || 0) * scaleY;

    // Determine Anchor X
    let anchorX = (canvas.width - popupWidth) / 2; // Default Center
    if (posKeyword === "left") anchorX = posMargin;
    else if (posKeyword === "right")
      anchorX = canvas.width - popupWidth - posMargin;

    // Determine Anchor Y Base
    let anchorYBase = 0;
    let stackDirection = 1; // 1 = down, -1 = up

    if (posKeyword === "bottom") {
      anchorYBase = canvas.height - posMargin - popupHeight;
      stackDirection = -1; // Stack upwards
    } else if (
      posKeyword === "top" ||
      posKeyword === "center" ||
      posKeyword === "left" ||
      posKeyword === "right"
    ) {
      anchorYBase = posMargin;
      stackDirection = 1; // Stack downwards
    }

    ctx.font = `bold ${fontSize}px ${fontFamily}`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    // --- Render Loop ---
    this.popups.forEach((popup, i) => {
      // Calculate Y position based on stack index
      const stackOffset = i * (popupHeight + spacing) * stackDirection;
      const x = anchorX;
      const y = anchorYBase + stackOffset + popup.yOffset;

      // Apply Global Opacity combined with Fade Opacity
      const finalAlpha = opacity * popup.alpha;

      // 1. Draw Border (Underneath)
      if (borderThickness > 0) {
        // Use alpha for border too
        ctx.save();
        ctx.globalAlpha = finalAlpha;
        this.drawStyledBox(
          ctx,
          x,
          y,
          popupWidth,
          popupHeight,
          borderThickness,
          cornerRadii,
          "rgba(0,0,0,0)", // Transparent fill
          borderColor
        );
        ctx.restore();
      }

      // 2. Draw Fill (Background)
      // Note: popup.color is already a hex string from resolveColor. We need to add alpha.
      const fillStyle = this.hexToRgba(popup.color, finalAlpha);

      // Use drawStyledBox for fill (border thickness 0)
      // We do this to reuse the rounded corner path logic
      this.drawStyledBox(
        ctx,
        x,
        y,
        popupWidth,
        popupHeight,
        0,
        cornerRadii,
        fillStyle,
        "transparent"
      );

      // 3. Draw Text
      ctx.fillStyle = this.hexToRgba(fontColor, finalAlpha);
      ctx.fillText(popup.message, x + popupWidth / 2, y + popupHeight / 2);
    });
  }
}
